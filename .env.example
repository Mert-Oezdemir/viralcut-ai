# No API key is required for offline motion/audio analysis and FFmpeg rendering.
# Gemini is OPTIONAL for deep multimodal video understanding and semantic cut selection.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPTIONAL YouTube Data API v3: trends, comments, metadata. Has quotas.
YOUTUBE_API_KEY=
# OPTIONAL: local ASR and image understanding (requires separately installed models)
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE=int8
OLLAMA_VISION_MODEL=qwen3-vl:4b
# OPTIONAL persistent local workspace
# DATA_DIR=./workspace
